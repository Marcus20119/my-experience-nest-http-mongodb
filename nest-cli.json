{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "compilerOptions": {
    "assets": [
      {
        "include": "locales/**/*.json",
        "outDir": "dist",
        "watchAssets": true
      },
      {
        "include": "services/**/*.pug",
        "outDir": "dist",
        "watchAssets": true
      },
      {
        "include": "db/global-bundle.pem",
        "outDir": "dist",
        "watchAssets": true
      }
    ],
    "builder": {
      "options": {
        "swcrcPath": ".swcrc.json"
      },
      "type": "swc"
    },
    "deleteOutDir": true
  },
  "sourceRoot": "src"
}
